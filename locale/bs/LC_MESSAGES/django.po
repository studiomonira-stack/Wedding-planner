#: .\accounts\templates\accounts\kop.html:8
msgid "Bröllopsplaneraren – Planera ert drömbröllop"
msgstr "Planerator za vjenčanja – Planirajte svoje vjenčanje iz snova"

#: .\accounts\templates\accounts\kop.html:249
msgid "Planera kärleken. Njut av resan."
msgstr "Planirajte ljubav. Uživajte u putovanju."

#: .\accounts\templates\accounts\kop.html:250
#| msgid "Planera ert drömbröllop – allt på ett ställe"
msgid "Allt ni behöver för att planera ert drömbröllop. Samlat på ett ställe."
msgstr ""
"Sve što vam treba za planiranje vjenčanja iz snova. Sve na jednom mjestu."

#: .\accounts\templates\accounts\kop.html:251
msgid ""
"Bröllopsplaneraren hjälper er hålla koll på allt från budget och checklista "
"till leverantörer, inspiration och tidslinje – så att ni kan fokusera på det"
" viktigaste: att njuta av resan tillsammans."
msgstr ""
"Planer vjenčanja vam pomaže da pratite sve, od budžeta i check-liste do "
"dobavljača, inspiracije i vremenske linije – tako da se možete fokusirati na"
" ono najvažnije: da zajedno uživate u putovanju."

#: .\accounts\templates\accounts\kop.html:253
#: .\accounts\templates\accounts\kop.html:323
msgid "Kom igång idag"
msgstr "Počnite danas"

#: .\accounts\templates\accounts\kop.html:254
#| msgid "Se hur det ser ut"
msgid "Se hur det fungerar"
msgstr "Pogledajte kako funkcioniše"

#: .\accounts\templates\accounts\kop.html:257
#: .\accounts\templates\accounts\kop.html:405
msgid "Inget abbonemang"
msgstr "Bez pretplate"

#: .\accounts\templates\accounts\kop.html:258
#| msgid "Engångspris"
msgid "Engångskostnad"
msgstr "Jednokratni trošak"

#: .\accounts\templates\accounts\kop.html:259
#: .\accounts\templates\accounts\kop.html:276
#: .\accounts\templates\accounts\kop.html:407
msgid "Planera tillsammans"
msgstr "Planirajte zajedno"

#: .\accounts\templates\accounts\kop.html:273
msgid "Planera tillsammans, var ni än är."
msgstr "Planirajte zajedno, gdje god da ste."

#: .\accounts\templates\accounts\kop.html:274
msgid ""
"Oavsett om ni sitter bredvid varandra i soffan eller planerar från olika "
"städer finns allt samlat på ett ställe."
msgstr ""
"Bilo da sjedite jedno pored drugog na kauču ili planirate iz različitih "
"gradova, sve je na jednom mjestu."

#: .\accounts\templates\accounts\kop.html:277
msgid "Alla enheter"
msgstr "Svi uređaji"

#: .\accounts\templates\accounts\kop.html:278
msgid "Tryggt & säkert"
msgstr "Sigurno i zaštićeno"

#: .\accounts\templates\accounts\kop.html:287
#| msgid "Allt ni behöver – samlat"
msgid "Allt ni behöver"
msgstr "Sve što vam treba"

#: .\accounts\templates\accounts\kop.html:289
msgid "Få full kontroll över er ekonomi."
msgstr "Imajte potpunu kontrolu nad svojim budžetom."

#: .\accounts\templates\accounts\kop.html:290
msgid "Vet alltid vad som händer härnäst."
msgstr "Uvijek znajte šta je sljedeće."

#: .\accounts\templates\accounts\kop.html:291
#: .\accounts\templates\accounts\kop.html:306
#: .\accounts\templates\accounts\landing.html:392
#: .\planner\templates\planner\gastlista.html:5
msgid "Gästlista"
msgstr "Lista gostiju"

#: .\accounts\templates\accounts\kop.html:291
#| msgid "Samla alla era leverantörer på ett ställe."
msgid "Samla alla gäster på ett ställe."
msgstr "Sakupite sve goste na jednom mjestu."

#: .\accounts\templates\accounts\kop.html:292
msgid "Bocka av allt i lugn och ro."
msgstr "Otkačite sve u miru i bez žurbe."

#: .\accounts\templates\accounts\kop.html:293
#: .\accounts\templates\accounts\kop.html:309
msgid "Moodboard"
msgstr "Moodboard"

#: .\accounts\templates\accounts\kop.html:293
#: .\accounts\templates\accounts\kop.html:309
#| msgid "Samla inspiration från Pinterest och Instagram."
msgid "Samla inspiration på ett ställe"
msgstr "Sakupite inspiraciju na jednom mjestu"

#: .\accounts\templates\accounts\kop.html:294
msgid "Samla inspiration tillsammans."
msgstr "Sakupljajte inspiraciju zajedno."

#: .\accounts\templates\accounts\kop.html:302
msgid "Utforska funktionerna"
msgstr "Istražite funkcije"

#: .\accounts\templates\accounts\kop.html:304
#| msgid "Här är en överblick över er bröllopsplanering."
msgid "Få en tydlig överblick över alla kostnader."
msgstr "Dobijte jasan pregled svih troškova."

#: .\accounts\templates\accounts\kop.html:305
msgid "Ha koll på allt som måste göras."
msgstr "Imajte pregled svega što treba uraditi."

#: .\accounts\templates\accounts\kop.html:306
#| msgid "Håll koll på allt inför er stora dag."
msgid "Håll koll på alla gäster."
msgstr "Pratite sve goste."

#: .\accounts\templates\accounts\kop.html:307
#| msgid "Planera bröllopsdagen minut för minut."
msgid "Planera bröllopsdagen."
msgstr "Planirajte dan vjenčanja."

#: .\accounts\templates\accounts\kop.html:308
#| msgid "Samla alla kontakter och jämför priser."
msgid "Samla alla kontakter."
msgstr "Sakupite sve kontakte."

#: .\accounts\templates\accounts\kop.html:320
msgid "En resa ni aldrig glömmer"
msgstr "Putovanje koje nikada nećete zaboraviti"

#: .\accounts\templates\accounts\kop.html:321
msgid "Allt börjar med ett"
msgstr "Sve počinje jednom"

#: .\accounts\templates\accounts\kop.html:322
msgid ""
"Vi är med er hela vägen – från den första drömmen till sista dansen och alla"
" minnen däremellan."
msgstr ""
"Tu smo za vas cijelim putem – od prvog sna do posljednjeg plesa i svih "
"uspomena između."

#: .\accounts\templates\accounts\kop.html:327
msgid "Förlovning"
msgstr "Zaruke"

#: .\accounts\templates\accounts\kop.html:329
msgid "Planering"
msgstr "Planiranje"

#: .\accounts\templates\accounts\kop.html:331
msgid "Detaljerna"
msgstr "Detalji"

#: .\accounts\templates\accounts\kop.html:333
#| msgid "Bröllopsplaneraren"
msgid "Bröllopsdagen"
msgstr "Dan vjenčanja"

#: .\accounts\templates\accounts\kop.html:335
msgid "Minnena"
msgstr "Uspomene"

#: .\accounts\templates\accounts\kop.html:378
msgid "Ta planeringen till nästa nivå."
msgstr "Podignite planiranje na viši nivo."

#: .\accounts\templates\accounts\kop.html:379
msgid ""
"Bröllopsplaneraren samlar allt på ett ställe så att ni slipper hålla reda på"
" dokument, anteckningar och olika appar. Ni kan fokusera på det viktigaste –"
" att njuta av resan mot er stora dag."
msgstr ""
"Planer vjenčanja sakuplja sve na jednom mjestu tako da ne morate pratiti "
"dokumente, bilješke i različite aplikacije. Možete se fokusirati na ono "
"najvažnije – da uživate u putovanju prema vašem velikom danu."

#: .\accounts\templates\accounts\kop.html:381
msgid "Full kontroll över planeringen"
msgstr "Potpuna kontrola nad planiranjem"

#: .\accounts\templates\accounts\kop.html:382
#| msgid "Samla alla era leverantörer på ett ställe."
msgid "Allt samlat på ett ställe"
msgstr "Sve na jednom mjestu"

#: .\accounts\templates\accounts\kop.html:383
msgid "En planering ni delar tillsammans"
msgstr "Planiranje koje dijelite zajedno"

#: .\accounts\templates\accounts\kop.html:384
msgid "Tillgång när ni behöver den"
msgstr "Pristup kada vam je potreban"

#: .\accounts\templates\accounts\kop.html:386
#| msgid "Börja planera ert drömbröllop"
msgid "Börja planera idag"
msgstr "Počnite planirati danas"

#: .\accounts\templates\accounts\kop.html:401
#| msgid "Börja planera ert drömbröllop"
msgid "Redo att börja planera ert drömbröllop?"
msgstr "Spremni da počnete planirati svoje vjenčanje iz snova?"

#: .\accounts\templates\accounts\kop.html:402
#| msgid "Samla alla era leverantörer på ett ställe."
msgid "Skapa ert konto idag och samla hela planeringen på ett ställe."
msgstr ""
"Kreirajte svoj račun danas i sakupite cijelo planiranje na jednom mjestu."

#: .\accounts\templates\accounts\kop.html:403
#| msgid "Börja planera ert drömbröllop"
msgid "Börja planera som ett proffs"
msgstr "Počnite planirati kao profesionalac"

#: .\accounts\templates\accounts\kop.html:406
#| msgid "Engångspris"
msgid "Engångsavgift"
msgstr "Jednokratna naknada"

#: .\accounts\templates\accounts\kop.html:417
#| msgid "Är du fotograf? Bli partner här →"
msgid "Är du fotograf? Bli partner →"
msgstr "Jeste li fotograf? Postanite partner →"

#: .\accounts\templates\accounts\landing.html:9
#| msgid "Bröllopsplaneraren – Planera ert drömbröllop"
msgid "Bröllopsplaneraren – För kreatörer"
msgstr "Planer vjenčanja – Za kreatore"

#: .\accounts\templates\accounts\landing.html:364
#| msgid "Byggt för bröllopsfotografer och kreativa studior"
msgid "Partnerprogram för bröllopsfotografer & kreatörer"
msgstr "Partnerski program za fotografe vjenčanja i kreatore"

#: .\accounts\templates\accounts\landing.html:368
#: .\accounts\templates\accounts\landing.html:470
#| msgid "Ansök om partnerskap →"
msgid "Ansök om partnerskap"
msgstr "Prijavite se za partnerstvo"

#: .\accounts\templates\accounts\landing.html:369
msgid "Upptäck hur det fungerar"
msgstr "Otkrijte kako funkcioniše"

#: .\accounts\templates\accounts\landing.html:372
msgid "Kostnadsfritt att gå med"
msgstr "Besplatno pridruživanje"

#: .\accounts\templates\accounts\landing.html:373
msgid "Erbjud på ditt sätt"
msgstr "Ponudite na svoj način"

#: .\accounts\templates\accounts\landing.html:374
#| msgid "Vad fotografer säger"
msgid "För fotografer & kreatörer"
msgstr "Za fotografe i kreatore"

#: .\accounts\templates\accounts\landing.html:386
msgid "Ett fantastiskt bröllop börjar med en fantastisk planering"
msgstr "Fantastično vjenčanje počinje fantastičnim planiranjem"

#: .\accounts\templates\accounts\landing.html:387
msgid "Ett digitalt hem för hela bröllopsresan."
msgstr "Digitalni dom za cijelo putovanje vjenčanja."

#: .\accounts\templates\accounts\landing.html:388
msgid ""
"Allt samlat på ett ställe – enkelt, vackert och skapat för moderna brudpar."
msgstr ""
"Sve na jednom mjestu – jednostavno, lijepo i stvoreno za moderne mladence."

#: .\accounts\templates\accounts\landing.html:405
msgid "När dina kunder får en bättre upplevelse får du också det"
msgstr "Kada vaši klijenti dobiju bolje iskustvo, dobijate ga i vi"

#: .\accounts\templates\accounts\landing.html:407
msgid "En starkare kundrelation"
msgstr "Snažniji odnos s klijentima"

#: .\accounts\templates\accounts\landing.html:407
msgid "Var med under hela planeringsresan – inte bara på bröllopsdagen."
msgstr "Budite tu tokom cijelog puta planiranja – ne samo na dan vjenčanja."

#: .\accounts\templates\accounts\landing.html:408
msgid "Ett tydligt mervärde"
msgstr "Jasna dodatna vrijednost"

#: .\accounts\templates\accounts\landing.html:408
msgid "Erbjud något som gör att ditt företag sticker ut."
msgstr "Ponudite nešto što čini da se vaše preduzeće izdvaja."

#: .\accounts\templates\accounts\landing.html:409
msgid "Ett starkare varumärke"
msgstr "Snažniji brend"

#: .\accounts\templates\accounts\landing.html:409
msgid ""
"Visa att du bryr dig om hela upplevelsen – från första mötet till sista "
"bilden."
msgstr ""
"Pokažite da brinete o cijelom doživljaju – od prvog susreta do posljednje "
"fotografije."

#: .\accounts\templates\accounts\landing.html:410
msgid "Flexibla intäktsmöjligheter"
msgstr "Fleksibilne mogućnosti zarade"

#: .\accounts\templates\accounts\landing.html:410
msgid "Välj själv hur du vill erbjuda Bröllopsplaneraren till dina kunder."
msgstr ""
"Sami odaberite kako želite ponuditi Planer vjenčanja svojim klijentima."

#: .\accounts\templates\accounts\landing.html:418
msgid "Två sätt att samarbeta"
msgstr "Dva načina saradnje"

#: .\accounts\templates\accounts\landing.html:423
msgid "Inkludera i dina paket"
msgstr "Uključite u svoje pakete"

#: .\accounts\templates\accounts\landing.html:424
msgid "För kreatörer som vill erbjuda en komplett premiumupplevelse."
msgstr "Za kreatore koji žele ponuditi kompletno premium iskustvo."

#: .\accounts\templates\accounts\landing.html:425
msgid "Köp tillgång till partnerpris"
msgstr "Kupite pristup po partnerskoj cijeni"

#: .\accounts\templates\accounts\landing.html:425
msgid "Ge kunden tillgång direkt"
msgstr "Dajte klijentu direktan pristup"

#: .\accounts\templates\accounts\landing.html:425
msgid "Integrera i dina egna paket"
msgstr "Integrirajte u svoje pakete"

#: .\accounts\templates\accounts\landing.html:426
#: .\accounts\templates\accounts\landing.html:435
msgid "Läs mer"
msgstr "Pročitajte više"

#: .\accounts\templates\accounts\landing.html:432
msgid "Rekommendera till kunder"
msgstr "Preporučite klijentima"

#: .\accounts\templates\accounts\landing.html:433
msgid "Perfekt om du vill erbjuda utan att ändra dina paket."
msgstr "Savršeno ako želite ponuditi bez mijenjanja svojih paketa."

#: .\accounts\templates\accounts\landing.html:434
msgid "Dela din personliga partnerlänk"
msgstr "Podijelite svoj lični partnerski link"

#: .\accounts\templates\accounts\landing.html:434
msgid "Kunden väljer själv"
msgstr "Klijent sam bira"

#: .\accounts\templates\accounts\landing.html:434
msgid "Du får ersättning vid registrering"
msgstr "Dobijate naknadu pri registraciji"

#: .\accounts\templates\accounts\landing.html:439
msgid "Eller kombinera båda – valet är helt ditt."
msgstr "Ili kombinirajte oba – izbor je u potpunosti vaš."

#: .\accounts\templates\accounts\landing.html:448
#| msgid "Allt samlat. Alltid tillgängligt."
msgid "Allt samlat i din"
msgstr "Sve sakupljeno u vašem"

#: .\accounts\templates\accounts\landing.html:449
msgid "Partner Studio."
msgstr "Partnerski Studio."

#: .\accounts\templates\accounts\landing.html:450
msgid ""
"En lugn och överskådlig plats där du har full koll på dina kunder, kommande "
"bröllop och möjligheter."
msgstr ""
"Mirno i pregledno mjesto gdje imate potpunu kontrolu nad svojim klijentima, "
"predstojećim vjenčanjima i mogućnostima."

#: .\accounts\templates\accounts\landing.html:452
#| msgid "Lägg till bild"
msgid "Lägg till fototider"
msgstr "Dodajte termine fotografisanja"

#: .\accounts\templates\accounts\landing.html:452
msgid "Planera in dina tider i kundens tidslinje."
msgstr "Planirajte svoje termine u vremenskoj liniji klijenta."

#: .\accounts\templates\accounts\landing.html:453
msgid "Hantera kunder"
msgstr "Upravljanje klijentima"

#: .\accounts\templates\accounts\landing.html:453
msgid "Full överblick över alla par."
msgstr "Potpuni pregled svih parova."

#: .\accounts\templates\accounts\landing.html:454
#: .\planner\templates\planner\partner_dashboard.html:20
#: .\planner\templates\planner\partner_dashboard.html:50
msgid "Kommande bröllop"
