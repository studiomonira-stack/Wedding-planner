#: .\accounts\templates\accounts\kop.html:8
msgid "Bröllopsplaneraren – Planera ert drömbröllop"
msgstr "Bryllupsplanleggeren - Planlegge drømmebryllupet"

#: .\accounts\templates\accounts\kop.html:269
msgid "Planera kärleken. Njut av resan."
msgstr "Planlegg kjærligheten. Nyt reisen."

#: .\accounts\templates\accounts\kop.html:270
msgid "Allt ni behöver för att planera ert drömbröllop. Samlat på ett ställe."
msgstr "Alt dere trenger for å planlegge drømmebryllupet. Samlet på ett sted."

#: .\accounts\templates\accounts\kop.html:271
msgid ""
"Bröllopsplaneraren hjälper er hålla koll på allt från budget och checklista "
"till leverantörer, inspiration och tidslinje – så att ni kan fokusera på det"
" viktigaste: att njuta av resan tillsammans."
msgstr ""
"Bryllupsplanleggeren hjelper dere med å holde oversikt over alt fra budsjett"
" og sjekkliste til leverandører, inspirasjon og tidslinje – slik at dere kan"
" fokusere på det viktigste: å nyte reisen sammen."

